# Chave da API do Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Senha pedida para abrir o app (entre aspas: um # sem aspas vira comentário)
APP_PASSWORD="troque-esta-senha"

# Texto aleatório longo, usado para assinar a sessão (ex.: openssl rand -hex 32)
SESSION_SECRET=

# Opcional: fotos ilustrativas do Pexels (pexels.com/api). Sem a chave, só usa a foto da notícia.
PEXELS_API_KEY=
